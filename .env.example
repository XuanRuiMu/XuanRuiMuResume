# 前端功能开关
VITE_ENABLE_ANALYTICS=false

# 联系表单邮件服务（可选）
# 支持 resend 或 sendgrid；配置 API Key 后将直接发送邮件，否则写入 KV
CONTACT_PROVIDER=resend
CONTACT_FROM_EMAIL=noreply@example.com
CONTACT_TO_EMAIL=your@email.com
RESEND_API_KEY=
SENDGRID_API_KEY=

# AI 助手默认模型（DeepSeek，OpenAI 兼容）
VITE_DEEPSEEK_API_KEY=

# AI 助手可选模型 GLM（Anthropic 兼容；对应你终端配置的 ANTHROPIC_* 映射）
# ANTHROPIC_BASE_URL → VITE_GLM_BASE_URL，ANTHROPIC_AUTH_TOKEN → VITE_GLM_API_KEY，ANTHROPIC_MODEL → VITE_GLM_MODEL
# 注意：密钥只放本地 .env.local（已忽略），禁止提交到仓库
# VITE_GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
# VITE_GLM_API_KEY=你的token放本地env文件
# VITE_GLM_MODEL=glm-4.7-flash
